# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---- database -------------------------------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:5432/afrinext
# Used only by the test suite. Must be a disposable database — it is truncated.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/afrinext_test
DATABASE_POOL_MAX=10

# ---- application ----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ---- payments -------------------------------------------------------------
# 'mock' is the only provider implemented. 'ipaymoney' exists as a boundary and
# throws ProviderNotConfiguredError until the official documentation is available.
PAYMENT_PROVIDER=mock
# IPAYMONEY_BASE_URL=
# IPAYMONEY_API_KEY=
# IPAYMONEY_WEBHOOK_SECRET=

# ---- observability --------------------------------------------------------
LOG_LEVEL=info

# ---- messaging -----------------------------------------------------------
# No SMS/email provider is chosen yet. ConsoleSender writes codes to the log and
# refuses to run with NODE_ENV=production unless you opt in explicitly.
# NEVER set this in a real deployment.
# ALLOW_CONSOLE_SENDER=yes
