# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---- database -------------------------------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:5432/afrinext
# Used only by the test suite. Must be a disposable database — it is truncated.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/afrinext_test
DATABASE_POOL_MAX=10

# ---- application ----------------------------------------------------------
# NODE_ENV is deliberately NOT set here.
#
# Every command already sets the right value for itself: `next dev` uses
# development, `next build` and `next start` use production, vitest uses test.
# Exporting it from this file overrides all of them, and the consequences are
# not theoretical — it made `pnpm build` fail while prerendering the global
# error page, and it made the browser suite serve a development build while CI
# served a production one, which is how a green local run shipped a red CI run.
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ---- payments -------------------------------------------------------------
# 'mock' is the only provider implemented. 'ipaymoney' exists as a boundary and
# throws ProviderNotConfiguredError until the official documentation is available.
PAYMENT_PROVIDER=mock
# The mock refuses to run under a production build unless this ALSO says so.
# PAYMENT_PROVIDER is the variable a deployment gets wrong, so getting it wrong
# must not be enough to start confirming payments nobody made.
# NEVER set this in a real deployment.
# ALLOW_MOCK_PAYMENTS=yes
# What the mock signs its webhooks with. Only meaningful for the mock.
# MOCK_WEBHOOK_SECRET=mock-webhook-secret
# iPayMoney is the confirmed provider and is NOT implemented: no documentation,
# no sandbox, no credentials. These stay commented until all three exist.
# IPAYMONEY_BASE_URL=
# IPAYMONEY_API_KEY=
# IPAYMONEY_WEBHOOK_SECRET=

# Grants the `seller` role to every NEW account at signup, so a test account can
# open a shop without an operator running SQL. A real role_assignments row, not a
# bypass: authorize() is untouched and the role holds only `store.create`.
# In production this hands a shop to anybody who can receive an SMS.
# NEVER set this in a real deployment. Only the exact string "yes" enables it.
# ALLOW_PREVIEW_SELLERS=yes

# ---- digital content ------------------------------------------------------
# Which ContentStorage adapter serves this deployment: 'filesystem' or 's3'.
CONTENT_STORAGE=filesystem

# --- filesystem adapter ---
# A local directory: single-machine storage, fine for development, CI and one
# server, WRONG for two web instances behind a load balancer — a file uploaded
# by one is not on the other's disk. It therefore refuses to run under a
# production build unless the next variable says the tradeoff was deliberate.
CONTENT_STORAGE_DIR=.content-storage
# NEVER set this on a multi-instance deployment.
# ALLOW_LOCAL_CONTENT_STORAGE=yes

# --- s3 adapter: Cloudflare R2 in production ---
# S3-COMPATIBLE, not AWS-only: the same adapter speaks to Cloudflare R2,
# Backblaze B2, Scaleway, DigitalOcean Spaces, MinIO and AWS S3. R2 is the
# chosen provider, for one reason: egress is free, and a catalogue whose
# product IS repeated downloads pays its bill in egress.
#
# The bucket MUST be private. Nothing in this design works with — or needs —
# public object access, and no CORS policy is required because a browser never
# talks to the bucket at all. See docs/providers/r2/README.md.
#
# The endpoint must be https. A plaintext endpoint is refused: SigV4 signs a
# request, it does not encrypt it, so http:// would put these credentials on
# the wire. Loopback is the only exception, for the test fixture.
#
# No Cloudflare account exists for Afrinext yet, so nothing sets
# CONTENT_STORAGE=s3 in this file. Render sets it, and takes the four values
# below from its own dashboard, never from Git.
# CONTENT_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 has no AWS-style regions. This literal is what the signature carries.
# CONTENT_S3_REGION=auto
# One bucket per environment, never shared: -prod, -preview.
# CONTENT_S3_BUCKET=afrinext-content-prod
# ---- SECRETS. An R2 API token, "Object Read & Write", scoped to that bucket
# ---- only. Never commit values here.
# CONTENT_S3_ACCESS_KEY_ID=
# CONTENT_S3_SECRET_ACCESS_KEY=
# 'yes' for R2, MinIO and most S3-compatible providers; omit for AWS S3 itself.
# CONTENT_S3_FORCE_PATH_STYLE=yes

# ---- observability --------------------------------------------------------
LOG_LEVEL=info

# ---- messaging -----------------------------------------------------------
# No SMS/email provider is chosen yet. ConsoleSender writes codes to the log and
# refuses to run with NODE_ENV=production unless you opt in explicitly.
# NEVER set this in a real deployment.
# ALLOW_CONSOLE_SENDER=yes
