# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---- database -------------------------------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:5432/afrinext
# Used only by the test suite. Must be a disposable database — it is truncated.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/afrinext_test
DATABASE_POOL_MAX=10

# ---- application ----------------------------------------------------------
# NODE_ENV is deliberately NOT set here.
#
# Every command already sets the right value for itself: `next dev` uses
# development, `next build` and `next start` use production, vitest uses test.
# Exporting it from this file overrides all of them, and the consequences are
# not theoretical — it made `pnpm build` fail while prerendering the global
# error page, and it made the browser suite serve a development build while CI
# served a production one, which is how a green local run shipped a red CI run.
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ---- payments -------------------------------------------------------------
# 'mock' is the only provider implemented. 'ipaymoney' exists as a boundary and
# throws ProviderNotConfiguredError until the official documentation is available.
PAYMENT_PROVIDER=mock
# The mock refuses to run under a production build unless this ALSO says so.
# PAYMENT_PROVIDER is the variable a deployment gets wrong, so getting it wrong
# must not be enough to start confirming payments nobody made.
# NEVER set this in a real deployment.
# ALLOW_MOCK_PAYMENTS=yes
# What the mock signs its webhooks with. Only meaningful for the mock.
# MOCK_WEBHOOK_SECRET=mock-webhook-secret

# Grants the `seller` role to every NEW account at signup, so a test account can
# open a shop without an operator running SQL. A real role_assignments row, not a
# bypass: authorize() is untouched and the role holds only `store.create`.
# In production this hands a shop to anybody who can receive an SMS.
# NEVER set this in a real deployment. Only the exact string "yes" enables it.
# ALLOW_PREVIEW_SELLERS=yes

# ---- digital content ------------------------------------------------------
# Where uploaded product files are stored. A local directory: single-machine
# storage, fine for development, CI and one server, wrong for two web instances
# behind a load balancer. No object store is configured for Afrinext yet, and
# adding one is a second implementation of the ContentStorage port rather than
# a change anywhere else.
CONTENT_STORAGE_DIR=.content-storage
# IPAYMONEY_BASE_URL=
# IPAYMONEY_API_KEY=
# IPAYMONEY_WEBHOOK_SECRET=

# ---- observability --------------------------------------------------------
LOG_LEVEL=info

# ---- messaging -----------------------------------------------------------
# No SMS/email provider is chosen yet. ConsoleSender writes codes to the log and
# refuses to run with NODE_ENV=production unless you opt in explicitly.
# NEVER set this in a real deployment.
# ALLOW_CONSOLE_SENDER=yes
