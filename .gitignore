# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
.next/
out/
next-env.d.ts

# build output
build/
dist/
.turbo/
*.tsbuildinfo

# testing
coverage/

# env files — never commit these
.env
.env.local
.env.*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# Design-audit working directory: screenshots, probe scripts, a scratch server
# log. Evidence for a review, never a deliverable.
apps/web/.audit/

# Playwright browser-test output
apps/web/.e2e/
apps/web/test-results/
apps/web/playwright-report/
# Playwright writes here when it is run from the repository root rather than
# from apps/web, which is easy to do by accident.
/test-results/
/playwright-report/

# Ad-hoc screenshot and fixture scripts written next to the app so they
# can resolve @playwright/test. Working files, never deliverables.
apps/web/.*.mjs

# Uploaded digital assets on a local filesystem store.
.content-storage/
