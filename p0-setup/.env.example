# M05 §11 — NOMS DE VARIABLES UNIQUEMENT. Ne jamais committer de secret réel.
# Copier en .env (gitignoré) et renseigner localement, ou utiliser un secret manager.

# ── PRIMARY : Google Cloud (seule famille joignable depuis cet environnement)
GOOGLE_API_KEY=                 # Gemini API / Veo — generativelanguage.googleapis.com
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS= # chemin vers le JSON de compte de service (TTS/STT/GCS)
TTS_PROVIDER=google
ASR_PROVIDER=google
VIDEO_GEN_PROVIDER=google_veo

# ── LIP-SYNC : bloqué par la politique réseau ici. À renseigner hors de cet environnement.
LIPSYNC_PROVIDER=
LIPSYNC_API_KEY=

# ── SECONDARY (injoignables ici, prêts pour un environnement à réseau ouvert)
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# ── GARDE-FOUS DE COÛT (§12) — obligatoires, valeurs par défaut conservatrices
MAX_COST_PER_RUN_USD=2.00
MAX_DAILY_COST_USD=25.00
MAX_CLIPS_PER_RUN=12
MAX_RETRIES_PER_STAGE=2
MAX_GENERATIONS_PER_DAY=300
DRY_RUN=true                    # true = aucun appel facturable n'est émis
